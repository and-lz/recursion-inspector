{
  "name": "recursion-inspector",
  "displayName": "Recursion Inspector",
  "description": "Visualiza passo a passo a execução de funções recursivas em JavaScript.",
  "version": "0.1.0",
  "publisher": "andre",
  "private": true,
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:javascript"
  ],
  "contributes": {
    "configuration": {
      "title": "Recursion Inspector",
      "properties": {
        "recursionInspector.layout": {
          "type": "string",
          "enum": [
            "tab",
            "fullscreen",
            "beside"
          ],
          "default": "tab",
          "description": "tab: painel abre como uma nova aba no grupo atual do editor. fullscreen: painel ocupa todo o editor (sidebar escondida). beside: painel ao lado do código, com a linha atual destacada."
        }
      }
    },
    "commands": [
      {
        "command": "recursionInspector.inspect",
        "title": "Recursion Inspector: Inspecionar função recursiva"
      }
    ]
  },
  "scripts": {
    "test": "node test/run-tests.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  }
}
